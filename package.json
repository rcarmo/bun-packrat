{
  "name": "bun-packrat",
  "version": "0.2.2",
  "description": "SQLite-backed web archive with canonical MHTML and byte-exact source PDF capture",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "cli": "bun run src/cli/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "migrate": "bun run src/db/migrate.ts",
    "typecheck": "bun --bun ./node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.18.9",
    "pdfjs-dist": "5.4.149",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
